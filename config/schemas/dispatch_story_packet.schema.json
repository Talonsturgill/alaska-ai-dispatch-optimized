{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alaskaaihq.com/schemas/dispatch-story-packet-v1.json",
  "title": "Alaska AI Dispatch compact story packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_date",
    "mode",
    "story",
    "claims",
    "sources",
    "research",
    "provenance",
    "measurement"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_date": {
      "type": "string",
      "format": "date"
    },
    "mode": {
      "enum": [
        "carousel_fact_pack",
        "bounded_fallback"
      ]
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "angle",
        "why_it_matters",
        "selection_excerpt",
        "scout_excerpt"
      ],
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "angle": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "selection_excerpt": {
          "type": "string"
        },
        "scout_excerpt": {
          "type": "string"
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^https://"
      },
      "uniqueItems": true
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broad_searches_used",
        "broad_search_cap",
        "fallback_used"
      ],
      "properties": {
        "broad_searches_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "broad_search_cap": {
          "const": 10
        },
        "fallback_used": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "input_sha256"
      ],
      "properties": {
        "source_kind": {
          "type": "string"
        },
        "input_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_estimator",
        "estimated_tokens",
        "maximum_estimated_tokens",
        "utf8_bytes"
      ],
      "properties": {
        "token_estimator": {
          "const": "ceil(utf8_bytes/4)"
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "maximum_estimated_tokens": {
          "const": 5000
        },
        "utf8_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim",
        "source_url",
        "source_outlet",
        "source_is_primary",
        "fetched",
        "date_of_source",
        "confidence",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "source_outlet": {
          "type": "string",
          "minLength": 1
        },
        "source_is_primary": {
          "type": "boolean"
        },
        "fetched": {
          "const": true
        },
        "date_of_source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
