{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alaskaaihq.com/schemas/dispatch-episode-props-v2.json",
  "title": "Alaska AI Dispatch parametric episode props",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "episode", "fps", "total", "safeZones", "palette",
    "assets", "sources", "scenes", "captions", "wordTimings", "credits"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "title", "subtitle", "provenance", "motion"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "title": {"type": "string", "minLength": 6, "maxLength": 72},
        "subtitle": {"type": "string", "minLength": 8, "maxLength": 120},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "notice"],
          "properties": {
            "kind": {"enum": ["historical_reconstruction", "synthetic_canary"]},
            "notice": {"type": "string", "minLength": 12, "maxLength": 180}
          }
        },
        "motion": {"enum": ["full", "reduced"]}
      }
    },
    "fps": {"const": 30},
    "total": {"type": "integer", "minimum": 3360, "maximum": 3900},
    "safeZones": {
      "type": "object",
      "additionalProperties": false,
      "required": ["squareTop", "squareBottom", "actionLeft", "actionRight", "captionTop", "captionBottom"],
      "properties": {
        "squareTop": {"const": 420},
        "squareBottom": {"const": 1500},
        "actionLeft": {"const": 72},
        "actionRight": {"const": 1008},
        "captionTop": {"const": 1328},
        "captionBottom": {"const": 1484}
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "paper", "accent", "signal"],
      "properties": {
        "ink": {"$ref": "#/$defs/color"},
        "paper": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "signal": {"$ref": "#/$defs/color"}
      }
    },
    "assets": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/asset"}},
    "sources": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/source"}},
    "scenes": {"type": "array", "minItems": 6, "maxItems": 16, "items": {"$ref": "#/$defs/scene"}},
    "captions": {"type": "array", "minItems": 1, "maxItems": 80, "items": {"$ref": "#/$defs/caption"}},
    "wordTimings": {"type": "array", "minItems": 1, "maxItems": 600, "items": {"$ref": "#/$defs/wordTiming"}},
    "credits": {"$ref": "#/$defs/credits"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "glyph", "alt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "symbol"},
        "glyph": {"enum": ["generator", "battery", "document", "pin", "people", "network", "clock", "spark"]},
        "alt": {"type": "string", "minLength": 4, "maxLength": 120},
        "credit": {"type": "string", "minLength": 2, "maxLength": 120}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "url", "claimIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 4, "maxLength": 110},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "claimIds": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "dur", "primitive", "eyebrow", "title", "body", "labels", "sourceIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"type": "integer", "minimum": 0},
        "dur": {"type": "integer", "minimum": 1},
        "primitive": {"enum": ["metric", "comparison", "timeline", "process", "document", "quote", "location", "closing"]},
        "eyebrow": {"type": "string", "minLength": 2, "maxLength": 34},
        "title": {"type": "string", "minLength": 4, "maxLength": 68},
        "body": {"type": "string", "minLength": 8, "maxLength": 118},
        "primaryValue": {"type": "string", "minLength": 1, "maxLength": 32},
        "secondaryValue": {"type": "string", "minLength": 1, "maxLength": 42},
        "labels": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 36}},
        "sourceIds": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/id"}},
        "assetId": {"$ref": "#/$defs/id"},
        "accent": {"$ref": "#/$defs/color"}
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "d", "text"],
      "properties": {
        "t": {"type": "number", "minimum": 0},
        "d": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
        "text": {"type": "string", "minLength": 1, "maxLength": 84}
      }
    },
    "wordTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "start", "end", "lineId"],
      "properties": {
        "word": {"type": "string", "minLength": 1, "maxLength": 48},
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0},
        "lineId": {"$ref": "#/$defs/id"}
      }
    },
    "credits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames", "seconds", "music", "sources", "sourceIds", "site"],
      "properties": {
        "frames": {"type": "integer", "minimum": 360, "maximum": 450},
        "seconds": {"type": "number", "minimum": 12, "maximum": 15},
        "music": {"type": "string", "minLength": 4, "maxLength": 140},
        "sources": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 4, "maxLength": 110}},
        "sourceIds": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/id"}},
        "site": {"const": "alaskaaihq.com"}
      }
    }
  },
  "x-runtime-invariants": [
    "Zod rejects duplicate scene, source, and asset identifiers.",
    "Scenes are contiguous from frame zero and end exactly where credits begin.",
    "Caption and word timings are ordered, non-overlapping, and cannot enter credits.",
    "Scene and credit references must resolve to declared source and asset identifiers.",
    "Historical reconstructions require source bindings on every scene.",
    "Synthetic canaries must carry no source bindings and cannot masquerade as sourced history."
  ]
}
